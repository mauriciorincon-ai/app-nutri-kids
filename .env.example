# Sentry (observabilidad) — crear proyecto en sentry.io y pegar el DSN.
# Sin DSN la app funciona igual (Sentry queda inactivo, útil en dev).
# En Vercel: Settings → Environment Variables (Production + Preview).
NEXT_PUBLIC_SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────────────
# Chat "habla con tu dieta" (Sprint 002) — el LLM del Camino B (preguntas abiertas).
# El Camino A ("¿X se puede?") es 100% local y NO usa nada de esto.
# ─────────────────────────────────────────────────────────────────────────────

# Proveedor activo del chat. Cambiarlo aquí conmuta el LLM SIN tocar código.
# Valores: groq | gemini | azure | anthropic | openai-compatible | mock
# Sin valor ⇒ "mock" (fixture determinística; lo que usa CI). "mock" no llama a ninguna red.
CHAT_PROVIDER=mock

# Kill-switch del Camino B. "false" ⇒ el chat responde lookups locales pero pausa la IA
# (estado "apagado" honesto). En prod arranca apagado hasta configurar el proveedor.
CHAT_ENABLED=false

# Espejo público del kill-switch para que la UI sepa mostrar el estado "apagado"
# sin exponer secretos (NEXT_PUBLIC_* se inlinea en build).
NEXT_PUBLIC_CHAT_ENABLED=false

# Modelo del proveedor. Vacío ⇒ el default del proveedor activo. Sobreescribe sin código.
CHAT_MODEL=

# --- Proveedor inicial: Groq (console.groq.com — free tier, sin tarjeta) ---
# Default de modelo: llama-3.3-70b-versatile
GROQ_API_KEY=

# --- Proveedores alternos: listos-para-env (NO crear estas cuentas ahora) ---
# GOOGLE_GENERATIVE_AI_API_KEY=   # gemini (default gemini-2.5-flash)
# AZURE_RESOURCE_NAME=            # azure
# AZURE_API_KEY=                  # azure
# ANTHROPIC_API_KEY=             # anthropic (default claude-haiku-4-5)
# CHAT_BASE_URL=                  # openai-compatible / self-host (+ su API key)
